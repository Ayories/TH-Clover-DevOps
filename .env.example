# Application environment variables, for running without Docker.
# Copy to .env (git-ignored), replace the placeholders, then load it into the shell:
#   set -a; source .env; set +a
# Never commit real values.
# For Docker Compose use infrastructure/local.env.example instead (see README.md).

# SQLite file for quick local runs; PostgreSQL form:
# postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///clover.db

APP_ENV=development
RELEASE_SHA=local

# Signs the session cookie used for CSRF protection. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_VALUE

STAFF_USERNAME=staff
# Werkzeug password hash, kept in SINGLE quotes because it contains '$'.
# Empty means staff access is refused. Generate with:
#   python -c "from getpass import getpass; from werkzeug.security import generate_password_hash as g; print(g(getpass()))"
STAFF_PASSWORD_HASH=''
