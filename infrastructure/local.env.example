# Copy to infrastructure/local.env (git-ignored). Development values only - never reuse on a server.
APP_IMAGE=th-clover:local
RELEASE_SHA=local
APP_ENV=development
APP_BIND=127.0.0.1
APP_PORT=8000
POSTGRES_USER=clover
POSTGRES_DB=clover
# Letters and digits only: the password is placed inside DATABASE_URL.
POSTGRES_PASSWORD=REPLACEWITHALOCALPASSWORD
SECRET_KEY=REPLACE_WITH_A_RANDOM_LOCAL_VALUE
STAFF_USERNAME=staff
# Leave empty to refuse staff access, or paste a werkzeug hash in SINGLE quotes. Create one with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g(input('password: ')))"
STAFF_PASSWORD_HASH=
